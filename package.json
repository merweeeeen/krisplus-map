	},
	"devDependencies": {
		"@types/leaflet": "1.9.22",
		"@types/leaflet.markercluster": "1.5.6",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"typescript": "7.0.2",
